# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gaitlogic_planner

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_DAYS=7

# OpenAI-compatible AI provider
AI_API_KEY=change-me
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=120
AI_PLAN_DAILY_LIMIT=3
AI_PLAN_COOLDOWN_SECONDS=60
# Optional private deployment override. Community prompt works when unset.
WEEKLY_REVIEW_PROMPT_OVERRIDE=

# Training readiness rollout
# off: disabled for everyone; allowlist: only feature_access users; all: all logged-in users
TRAINING_READINESS_ROLLOUT_MODE=off
AI_READINESS_EXPLANATION_ENABLED=false

# Legacy aliases still supported by backend config.
# DEEPSEEK_API_KEY=change-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=120

# Frontend development
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
