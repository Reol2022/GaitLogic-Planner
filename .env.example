# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gaitlogic_planner

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+):\d+$

# Remote MCP is disabled until a deployment explicitly enables it.  This is
# GaitLogic authenticated MCP HTTP mode, not an OAuth 2.1 authorization server.
MCP_HTTP_ENABLED=false
MCP_HTTP_HOST=127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
MCP_TOKEN_ISSUER=gaitlogic-planner
MCP_TOKEN_AUDIENCE=gaitlogic-mcp
MCP_TOKEN_EXPIRE_MINUTES=30

# OpenAI-compatible AI provider
AI_API_KEY=change-me
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=120
AI_PLAN_DAILY_LIMIT=3
AI_PLAN_COOLDOWN_SECONDS=60

# Coach Agent provider is independently disabled by default.
COACH_AGENT_ENABLED=false
COACH_AGENT_PROVIDER=openai_compatible
COACH_AGENT_API_KEY=
COACH_AGENT_BASE_URL=
COACH_AGENT_MODEL=
# unset preserves generic OpenAI-compatible behavior. v0.12.0 supports
# DeepSeek V4 non-thinking compatibility with disabled; enabled is reserved
# until reasoning_content replay is implemented for tool-call sub-turns.
COACH_AGENT_THINKING_MODE=disabled
COACH_AGENT_RESPONSE_FORMAT_MODE=json_object
COACH_AGENT_CONNECT_TIMEOUT_SECONDS=10
COACH_AGENT_READ_TIMEOUT_SECONDS=60
COACH_AGENT_TOTAL_TIMEOUT_SECONDS=90
COACH_AGENT_MAX_RETRIES=1
COACH_AGENT_RETRY_INITIAL_BACKOFF_SECONDS=0.25
COACH_AGENT_RETRY_MAX_BACKOFF_SECONDS=1
COACH_AGENT_MAX_OUTPUT_TOKENS=2000
COACH_AGENT_DAILY_LIMIT=30
COACH_AGENT_COOLDOWN_SECONDS=3
COACH_AGENT_ALLOW_LOCAL_PROVIDER_IN_DEVELOPMENT=false

# Training Knowledge Embedding is independent from Coach Agent and disabled by default.
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_EMBEDDING_PROVIDER=openai_compatible
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_MODEL=
# Uncomment only when the provider/model supports an explicit dimensions value.
# KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_EMBEDDING_READ_TIMEOUT_SECONDS=30
KNOWLEDGE_EMBEDDING_TOTAL_TIMEOUT_SECONDS=60
KNOWLEDGE_EMBEDDING_MAX_RETRIES=1
KNOWLEDGE_EMBEDDING_RETRY_INITIAL_BACKOFF_SECONDS=0.25
KNOWLEDGE_EMBEDDING_RETRY_MAX_BACKOFF_SECONDS=1
KNOWLEDGE_EMBEDDING_ALLOW_LOCAL_PROVIDER_IN_DEVELOPMENT=false

# Coach knowledge retrieval is separately controlled and never builds an index at request time.
COACH_AGENT_KNOWLEDGE_RETRIEVAL_ENABLED=false
COACH_AGENT_KNOWLEDGE_INDEX_ID=
# Dense remains the default. BM25 uses a separately versioned local index and
# never calls the embedding provider while answering a request.
KNOWLEDGE_RETRIEVAL_STRATEGY=dense
COACH_AGENT_KNOWLEDGE_BM25_INDEX_ID=
KNOWLEDGE_INDEX_RUNTIME_DIRECTORY=var/knowledge_indexes
KNOWLEDGE_BM25_INDEX_RUNTIME_DIRECTORY=var/knowledge_bm25_indexes
# Hybrid is opt-in and rank-based. Candidate depth is fixed by deployment, not
# client input; final public top_k remains bounded by the Tool contract.
KNOWLEDGE_HYBRID_FUSION=rrf
KNOWLEDGE_HYBRID_DENSE_CANDIDATES=8
KNOWLEDGE_HYBRID_BM25_CANDIDATES=8
# Reranking is opt-in. It receives only the public query and candidate chunk
# text, never runner facts, identities, or Canonical Reference metadata.
KNOWLEDGE_RERANKER_ENABLED=false
KNOWLEDGE_RERANKER_PROVIDER=siliconflow
KNOWLEDGE_RERANKER_API_KEY=
KNOWLEDGE_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
KNOWLEDGE_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
KNOWLEDGE_RERANKER_CONNECT_TIMEOUT_SECONDS=5
KNOWLEDGE_RERANKER_READ_TIMEOUT_SECONDS=20
KNOWLEDGE_RERANKER_TOTAL_TIMEOUT_SECONDS=30
KNOWLEDGE_RERANKER_MAX_RETRIES=1
KNOWLEDGE_RERANKER_RETRY_INITIAL_BACKOFF_SECONDS=0.25
KNOWLEDGE_RERANKER_RETRY_MAX_BACKOFF_SECONDS=1
KNOWLEDGE_INDEX_MAX_AGE_DAYS=30
COACH_AGENT_KNOWLEDGE_TOP_K=4
# Optional private deployment override. Community prompt works when unset.
WEEKLY_REVIEW_PROMPT_OVERRIDE=

# Training readiness rollout
# off: disabled for everyone; allowlist: only feature_access users; all: all logged-in users
TRAINING_READINESS_ROLLOUT_MODE=off
AI_READINESS_EXPLANATION_ENABLED=false

# Simplified workflow rollout
# off: disabled for everyone; allowlist: only feature_access users; all: all logged-in users
SIMPLIFIED_WORKFLOW_ROLLOUT_MODE=all

# Workout import rollout
# off: disabled for everyone; allowlist: only feature_access users; all: all logged-in users
WORKOUT_IMPORT_ROLLOUT_MODE=off

# Garmin sync rollout and worker
# off: disabled for everyone; allowlist: only feature_access users; all: all logged-in users
GARMIN_SYNC_ROLLOUT_MODE=off
# Data sync rollout. inherit keeps compatibility with GARMIN_SYNC_ROLLOUT_MODE.
DATA_SYNC_ROLLOUT_MODE=inherit
DATA_SYNC_MOCK_PROVIDER_ENABLED=false
GARMIN_TOKEN_ENCRYPTION_KEY=
GARMIN_TOKEN_KEY_VERSION=v1
GARMIN_RAW_RETENTION_DAYS=90
GARMIN_INITIAL_SYNC_DAYS=90
GARMIN_INCREMENTAL_OVERLAP_DAYS=3
GARMIN_CUSTOM_SYNC_MAX_DAYS=365
GARMIN_COMPOSITE_ACTIVITY_MAX_GAP_MINUTES=90
GARMIN_SYNC_WORKER_POLL_SECONDS=5
GARMIN_SYNC_MAX_RETRIES=3

# Legacy aliases still supported by backend config.
# DEEPSEEK_API_KEY=change-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=120

# Frontend development
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Application release stage, display only. Empty value hides the stage label.
VITE_APP_STAGE=Beta

# Environment isolation. Competition-only capabilities are disabled by default.
APP_ENV=development
COMPETITION_MODE=false
ENABLE_EXPERIMENT_DASHBOARD=false
ENABLE_AGENT_TRACE=false
# v0.14.0-B tracing is off by default. OTLP export is optional and never
# records prompts, identities, credentials, provider responses, or vectors.
AGENT_TRACING_ENABLED=false
AGENT_TRACE_EXPORTER=noop
# Optional bounded in-process aggregate metrics; no trace payload is retained.
AGENT_METRICS_ENABLED=false
AGENT_METRICS_MAX_LATENCY_SAMPLES=2048
# v0.16 vector store. Exact remains the default and needs no Qdrant service.
KNOWLEDGE_VECTOR_STORE=exact
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=gaitlogic
# Required only when AGENT_TRACING_ENABLED=true and AGENT_TRACE_EXPORTER=otlp.
# Use an endpoint without credentials, query parameters, or fragments.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
ENABLE_SURVEY_MODULE=false
ENABLE_COMPETITION_DEMO_DATA=false
