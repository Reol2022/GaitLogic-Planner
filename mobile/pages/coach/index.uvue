<template>
  <view :class="themeClass" class="chat-shell" @touchstart="navSwipe.start" @touchmove="navSwipe.move" @touchend="navSwipe.end" @touchcancel="navSwipe.cancel"><view class="chat-head"><view class="coach-identity"><image class="coach-head-icon" src="/static/tools/spark.png" /><view><text class="chat-name">洛教练</text><text class="coach-caption">跑步与训练</text></view></view><view class="head-actions"><button class="secondary head-button" :disabled="loading || sending || pendingTurn.length > 0" @click="create">新对话</button><button class="head-button" :disabled="loading || sending || pendingTurn.length > 0" @click="platform.navigate('/pages/workspace/conversations')">历史</button></view></view>
    <scroll-view direction="horizontal" @touchstart.stop="navSwipe.cancel" v-if="conversations.length > 1" class="conversation-scroll"><view class="conversation-row">
      <button v-for="item in conversations" :key="item.id" :class="item.id === selected ? 'conversation-button conversation-current' : 'conversation-button'" :disabled="loading || sending || pendingTurn.length > 0" @click="select(item.id)">{{ item.title || '训练对话' }}</button>
    </view></scroll-view>
    <scroll-view direction="vertical" class="chat-feed" :scroll-into-view="scrollTarget"><view class="feed-pad"><StatePanel :loading="loading" :error="error" @retry="load" />
    <view v-if="!loading && !error && history.length === 0" class="coach-welcome"><image class="coach-symbol" src="/static/navigation/coach-active.png" /><text class="welcome-title">今天想聊什么？</text><text class="body">{{ selected ? '选一个问题，或写下你关心的事。' : '新建对话，聊聊你的训练。' }}</text>
      <view v-if="selected && !pendingTurn && !sending"><button v-for="question in starters" :key="question" class="starter" @click="draft = question">{{ question }}</button></view>
    </view>
    <button v-if="history.length < total" :disabled="loading || sending" class="more-messages" @click="more">查看更早的消息</button>
    <view v-for="message in history" :key="message.id" :class="message.role === 'user' ? 'card user-message' : 'card coach-message'">
      <view class="row"><text class="label">{{ message.role === 'user' ? '你' : message.role === 'assistant' ? '洛教练' : '系统' }}</text><text v-if="message.status !== 'completed'" class="muted">{{ messageStatus(message.status) }}</text></view>
      <MarkdownMessage :content="message.content || '暂无正文，请核对本轮状态。'" />
      <text v-for="(warning, index) in message.warnings" :key="'w' + index" class="error-text spaced">{{ warning.message }}</text>
      <text v-for="(limit, index) in message.limitations" :key="'l' + index" class="muted spaced">{{ limit.message }}</text>
      <button v-if="message.role === 'assistant' && message.content != null" class="copy-action" @click="platform.copy(message.content)">复制回答</button>
    </view>
    <view v-if="sending && progress != null && !progress.terminal" class="progress-card"><view class="progress-head"><view class="progress-dot" /><text class="progress-title">{{ stageLabel(progress.stage) }}</text></view><text v-if="progress.summary.length === 0" class="muted">请稍候</text><text v-else class="muted">{{ progress.summary[progress.summary.length - 1].message }}</text></view>
    <view v-if="pendingTurn.length > 0 && !sending" class="notice"><text class="notice-text">{{ sending ? '正在等待服务端回答。' : '本轮结果尚待核对，请勿重复发送。' }}离开页面或取消等待，不代表服务端停止。</text><button :disabled="loading || sending" class="secondary" @click="checkPending">核对本轮状态与消息</button></view>
    <view id="conversation-latest" class="latest-anchor" />
  </view></scroll-view>
    <view v-if="selected.length > 0" class="composer">
      <view class="send-row"><input v-model="draft" class="input chat-input" placeholder="询问训练记录、计划或复盘" :maxlength="4000" :disabled="sending || pendingTurn.length > 0" @touchstart.stop="navSwipe.cancel" @confirm="send" />
      <button class="primary send-button" :disabled="loading || sending || pendingTurn.length > 0 || draft.trim().length === 0" @click="send">{{ sending ? '等待中' : '发送' }}</button></view>
      <button v-if="sending" class="secondary" @click="cancelWait">停止等待</button>
    </view>
    <text class="chat-note">建议仅供训练参考，不替代医疗诊断；修改课表需确认。</text>
  </view>
</template>
<script setup lang="ts">
import { useTheme } from '../../services/theme'
import { ref, nextTick } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import { api, auth, requireAuth, platform } from '../../services/runtime'
import { tabSwipe } from '../../utils/swipe'
import { ChatService } from '../../services/chat/service'
import { ApiError } from '../../services/api/client'
import type { Conversation, Message, Progress } from '../../types/contracts'
import { turnId } from '../../utils/id'
import { messageStatus } from '../../utils/display'
import MarkdownMessage from '../../components/coach/MarkdownMessage.uvue'
import StatePanel from '../../components/common/StatePanel.uvue'
function stageLabel(stage: string): string {
  const labels: Record<string,string> = { QUEUED: '正在排队', CONTEXT_LOADING: '正在读取对话', FACTS_LOADING: '正在读取训练记录', FACTS_READY: '训练记录已返回', GENERATING: '正在组织回答', VALIDATING: '正在核对回答', COMPLETED: '回答已完成', FAILED: '本次未完成' }
  return labels[stage] || '正在查询进度'
}
const starters = ['今天这次跑得怎么样？', '帮我复盘本周训练']
const service = new ChatService(api)
const scrollTarget = ref('')
async function scrollLatest(): Promise<void> { scrollTarget.value = ''; await nextTick(); scrollTarget.value = 'conversation-latest' }
const conversations = ref<Conversation[]>([]); const history = ref<Message[]>([]); const selected = ref(''); const draft = ref('')
const loading = ref(false); const sending = ref(false); const error = ref(''); const total = ref(0); const progress = ref<Progress | null>(null)
const pendingTurn = ref(''); let pendingConversation = ''; let owner: number | null = null; let page = 1; let generation = 0; let sendCancel: (() => void) | null = null; let createCancel: (() => void) | null = null
function describe(cause: unknown): string { return cause instanceof ApiError ? cause.message : '对话读取失败，请检查网络或登录状态后重试。' }
function stop(): void { generation++; sendCancel?.(); sendCancel = null; createCancel?.(); createCancel = null; service.cancelReads(); loading.value = false; sending.value = false }
function hide(): void { if (pendingTurn.value.length > 0) error.value = '已离开本页等待；服务端可能仍在处理，返回后请核对本轮状态。'; stop(); conversations.value = []; history.value = []; progress.value = null }
function resetOwner(): void { selected.value = ''; pendingTurn.value = ''; pendingConversation = ''; draft.value = ''; history.value = []; total.value = 0; progress.value = null }
async function readMessages(id: string, current: number, requestedPage: number = 1): Promise<void> {
  const result = await service.messages(id, requestedPage)
  if (current !== generation) return
  const merged = requestedPage === 1 ? result.items : history.value.concat(result.items.filter((item: Message) => !history.value.some((stored: Message) => stored.id === item.id)))
  history.value = merged.sort((a: Message, b: Message) => a.sequence_no - b.sequence_no); total.value = result.total; page = requestedPage
  if (requestedPage === 1) await scrollLatest()
}
async function load(): Promise<void> {
  stop(); const current = generation; loading.value = true
  try {
    if (!await requireAuth()) { if (current === generation) { resetOwner(); error.value = '请登录后查看对话。' }; return }
    if (current !== generation) return
    if (owner !== auth.state.user?.id) { resetOwner(); owner = auth.state.user?.id ?? null }
    const result = await service.listConversations()
    if (current !== generation) return
    conversations.value = result.items
    if (pendingTurn.value.length > 0) selected.value = pendingConversation
    else if (selected.value.length === 0 || !result.items.some((item: Conversation) => item.id === selected.value)) selected.value = result.items[0]?.id ?? ''
    if (selected.value.length > 0) await readMessages(selected.value, current)
    if (current === generation) error.value = pendingTurn.value.length > 0 ? '本轮结果尚未确认，请使用状态核对，不要重复发送。' : ''
  } catch (cause: unknown) { if (current === generation) error.value = describe(cause) }
  finally { if (current === generation) loading.value = false }
}
async function create(): Promise<void> {
  if (loading.value || sending.value || pendingTurn.value.length > 0) return
  const current = generation; loading.value = true
  try {
    // createConversation exposes only a Promise; retain a page-owned operation
    // for this POST so hiding this page never aborts another page's requests.
    const operation = api.post<Conversation>('/coach/conversations', {}); createCancel = () => operation.cancel(); const item = await operation.promise
    if (current !== generation) return
    conversations.value = [item].concat(conversations.value); selected.value = item.id; history.value = []; total.value = 0; page = 1; error.value = ''
  } catch (cause: unknown) { if (current === generation) error.value = describe(cause) }
  finally { if (current === generation) { loading.value = false; createCancel = null } }
}
async function select(id: string): Promise<void> {
  if (loading.value || sending.value || pendingTurn.value.length > 0) return
  const current = generation; loading.value = true; selected.value = id; history.value = []; total.value = 0
  try { await readMessages(id, current); if (current === generation) error.value = '' }
  catch (cause: unknown) { if (current === generation) error.value = describe(cause) }
  finally { if (current === generation) loading.value = false }
}
async function more(): Promise<void> {
  if (loading.value || sending.value) return
  const current = generation; loading.value = true
  try { await readMessages(selected.value, current, page + 1); if (current === generation) error.value = '' }
  catch (cause: unknown) { if (current === generation) error.value = describe(cause) }
  finally { if (current === generation) loading.value = false }
}
async function send(): Promise<void> {
  if (loading.value || sending.value || pendingTurn.value.length > 0 || selected.value.length === 0 || draft.value.trim().length === 0) return
  const current = generation; const text = draft.value.trim(); pendingTurn.value = turnId(); pendingConversation = selected.value; sending.value = true; progress.value = null
  try {
    const operation = service.send(selected.value, text, pendingTurn.value, (value: Progress) => { if (current === generation && sending.value && pendingTurn.value.length > 0) progress.value = value.terminal ? null : value })
    sendCancel = () => operation.cancel(); const result = await operation.promise
    if (current !== generation) return
    progress.value = null
    // A JSON response is displayed once; no simulated token stream.
    const local: Message = { id: result.message_id, role: 'assistant', content: result.content, status: result.status, sequence_no: (history.value[history.value.length - 1]?.sequence_no ?? 0) + 2, warnings: result.response?.warnings ?? [], limitations: result.response?.limitations ?? [] }
    history.value = history.value.concat([local]); draft.value = ''; error.value = ''
    if (['completed', 'failed', 'cancelled'].includes(result.status.toLowerCase())) pendingTurn.value = ''
    else error.value = '服务端尚未返回明确终态，请核对本轮状态。'
    await readMessages(selected.value, current)
  } catch (cause: unknown) { if (current === generation) error.value = describe(cause) + (pendingTurn.value.length > 0 ? ' 本轮是否已完成尚不确定，请核对状态，不会自动重发。' : ' 回答已收到，但历史刷新失败，可重新读取。') }
  finally { if (current === generation) { sending.value = false; progress.value = null; sendCancel = null } }
}
function cancelWait(): void { stop(); progress.value = null; error.value = '已取消本页网络等待与轮询，不代表服务端停止。请核对本轮状态。' }
async function checkPending(): Promise<void> {
  if (pendingTurn.value.length === 0 || loading.value || sending.value) return
  const current = generation; loading.value = true
  try {
    const result = await service.turnStatus(pendingConversation, pendingTurn.value)
    if (current !== generation) return
    progress.value = null
    await readMessages(pendingConversation, current)
    if (current !== generation) return
    if (result.progress.terminal) { pendingTurn.value = ''; draft.value = ''; error.value = '' }
    else error.value = '服务端尚未返回终态。稍后可再次核对；不要重复发送。'
  } catch (cause: unknown) { if (current === generation) error.value = describe(cause) + ' 未确认本轮终态，保留请求标识以供后续核对。' }
  finally { if (current === generation) loading.value = false }
}
onShow(() => { void load() }); onHide(hide); onUnload(hide)
const navSwipe = tabSwipe('/pages/coach/index', path => platform.tab(path))
const themeClass = useTheme(true)
</script>
<style>
@import '../../styles/tokens.css';
</style>
<style scoped>
/* #ifdef MP-WEIXIN || WEB */
.progress-dot { animation: pulse 1.2s ease-in-out infinite alternate; }
.coach-message { animation: reveal .22s ease-out; }
@keyframes pulse { from { opacity: .35; } to { opacity: 1; } }
@keyframes reveal { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
/* #endif */
.coach-welcome { padding:22px 5px; margin-top:13px; }
.coach-symbol { width:44px; height:44px; margin-bottom:18px; }
.welcome-title { font-size:26px; font-weight:700; color:var(--tone-text); margin-bottom:8px; }
.starter { align-self:stretch; margin:8px 0 0; padding:0 16px; border:1px solid; border-color:var(--tone-field-line); background-color:var(--tone-surface); border-radius:16px; font-size:14px; color:var(--tone-text); line-height:44px; }
.copy-action { align-self:flex-start; background-color:transparent; color:var(--tone-muted); margin:8px 0 0; padding:0; font-size:12px; line-height:36px; }
.latest-anchor { height: 1px; width: 100%; }
.conversation-scroll { height:46px; margin-top:6px; }
.conversation-row { display:flex; flex-direction:row; padding:0 16px; }
.conversation-button { flex-shrink: 0; margin: 0 8px 0 0; border-radius: 18px; background-color: var(--tone-soft); color: var(--tone-muted); font-size: 12px; line-height: 36px; }
.user-message { background-color: var(--tone-purple-bg); border-color: var(--tone-purple-bg); margin-left: 32px; border-radius: 16px 16px 4px 16px; }
.coach-message { background-color:transparent; border-width:0; padding:12px 0 16px; margin-right:0; }
.chat-shell { display:flex; flex-direction:column; height:100%; background-color:var(--tone-canvas); }
.progress-card { margin:10px 0; padding:14px; border-radius:16px; background-color:var(--tone-purple-bg); }
.progress-head { display:flex; flex-direction:row; align-items:center; margin-bottom:6px; }
.progress-dot { width:8px; height:8px; border-radius:4px; margin-right:8px; background-color:var(--tone-purple); }
.progress-title { color:var(--tone-purple); font-size:15px; font-weight:700; }
.coach-identity { display:flex; flex-direction:row; align-items:center; }
.coach-head-icon { width:25px; height:25px; margin-right:8px; }
.chat-head { display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding:12px 16px; background-color:var(--tone-canvas); border-bottom:1px solid transparent; border-bottom-color:var(--tone-line); }
.conversation-current { background-color:var(--tone-blue-soft); color:var(--tone-accent); }
.coach-caption { color:var(--tone-muted); font-size:11px; margin-top:2px; }
.more-messages { background-color:transparent; color:var(--tone-accent); font-size:12px; margin:0 0 10px; line-height:35px; }
.chat-name { font-size:21px; font-weight:700; color:var(--tone-text); }
.head-actions,.send-row { display:flex; flex-direction:row; align-items:center; }
.head-button { margin:0 0 0 8px; border:0; border-radius:8px; padding:0 12px; font-size:14px; line-height:40px; color:var(--tone-accent); background-color:var(--tone-blue-soft); }
.chat-feed { flex:1; min-height:0; }
.feed-pad { padding:16px; }
.composer { padding:10px 14px 4px; background-color:var(--tone-surface); border-top:1px solid; border-top-color:var(--tone-line); }
.chat-input { flex:1; min-width:0; }
.send-button { margin:0 0 0 8px; }
.chat-note { background-color:var(--tone-surface); text-align:center; padding:5px 10px; color:var(--tone-muted); font-size:11px; }
</style>
