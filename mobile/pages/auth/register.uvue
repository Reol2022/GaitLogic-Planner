<template>
  <scroll-view :class="themeClass" direction="vertical" class="screen"><view class="page"><view class="page-heading"><view class="heading-mark" /><text class="title">注册账号</text></view><text class="subtitle">注册权限以服务端当前设置为准。已有账号可以直接返回登录。</text><StatePanel :loading="loading" :error="error" @retry="load" />
    <view v-if="allowed" class="card"><text class="field-label">用户名</text><input v-model="username" class="input" :disabled="busy" :maxlength="64" /><text class="field-label">昵称（选填）</text><input v-model="nickname" class="input" :disabled="busy" :maxlength="64" /><text class="field-label">邮箱（选填）</text><input v-model="email" class="input" :disabled="busy" :maxlength="255" /><text class="field-label">密码</text><input v-model="password" class="input" password :disabled="busy" :maxlength="128" /><text class="field-label">再次输入密码</text><input v-model="confirmation" class="input" password :disabled="busy" :maxlength="128" /><button class="primary" :disabled="busy" @click="submit">{{ busy ? '正在注册…' : '注册账号' }}</button></view>
    <text v-if="!loading && !allowed && !error" class="notice-text">当前暂未开放公开注册。</text><text v-if="notice" class="notice-text">{{ notice }}</text><button class="secondary" :disabled="busy" @click="platform.relaunch('/pages/auth/login')">返回登录</button>
  </view></scroll-view>
</template>
<script setup lang="ts">
import { useTheme } from '../../services/theme'
import { ref } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import { api, auth, platform } from '../../services/runtime'
import { PageScope } from '../../services/page-scope'
import StatePanel from '../../components/common/StatePanel.uvue'
const username = ref(''), nickname = ref(''), email = ref(''), password = ref(''), confirmation = ref(''), notice = ref(''), error = ref(''), allowed = ref(false), loading = ref(false), busy = ref(false); const scope = new PageScope(() => auth.epoch())
async function load(): Promise<void> { const version = scope.begin(); loading.value = true; allowed.value = false; error.value = ''
  try { const result = await scope.wait(api.get<{ allow_public_registration: boolean }>('/system-settings')); if (scope.current(version)) allowed.value = result.allow_public_registration === true }
  catch (e) { if (scope.current(version)) error.value = e instanceof Error ? e.message : '无法确认注册配置，请重试' } finally { if (scope.current(version)) loading.value = false }
}
async function submit(): Promise<void> { if (busy.value || !allowed.value) return; if (!username.value.trim() || !password.value) { error.value = '请填写用户名和密码'; return }; if (password.value !== confirmation.value) { error.value = '两次密码不一致'; return }; const version = scope.begin(); busy.value = true; error.value = ''
  try { await scope.wait(api.post('/auth/register', { username: username.value.trim(), password: password.value, email: email.value.trim() || null, nickname: nickname.value.trim() || null })); if (scope.current(version)) { notice.value = '账号已注册，请返回登录。'; allowed.value = false } }
  catch (e) { if (scope.current(version)) error.value = (e instanceof Error ? e.message : '注册失败') + '。超时后请先尝试登录，不重复注册。' } finally { password.value = ''; confirmation.value = ''; if (scope.current(version)) busy.value = false }
}
function hide(): void { scope.stop(); username.value = ''; nickname.value = ''; email.value = ''; password.value = ''; confirmation.value = ''; allowed.value = false; busy.value = false }
onShow(() => { void load() }); onHide(hide); onUnload(hide)
const themeClass = useTheme()
</script>
<style>
@import '../../styles/tokens.css';
</style>
