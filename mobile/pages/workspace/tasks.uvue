<template>
  <scroll-view :class="themeClass" direction="vertical" class="screen"><view class="page"><view class="page-heading"><view class="heading-mark" /><text class="title">待办中心</text></view><text class="subtitle">待办来自现有服务端。标记处理不等于完成对应训练。</text><StatePanel :loading="loading" :error="error" @retry="load" />
    <view v-for="item in items" :key="item.task_key" class="card"><text class="item-title">{{ item.title }}</text><text class="body">{{ item.description }}</text><text class="muted">{{ item.count }} 项</text><button class="secondary" :disabled="busy" @click="selected = item.task_key">标记已处理</button></view>
    <text v-if="!loading && !error && !items.length" class="muted">当前没有待办事项。</text>
    <view v-if="selected" class="notice"><text class="body">确认标记此待办已处理？此操作不会代填训练日志，也不会修改课表。</text><button class="primary" :disabled="busy" @click="complete">确认标记</button><button class="secondary" :disabled="busy" @click="selected = ''">取消</button></view>
    <button class="secondary" @click="platform.navigate('/pages/workspace/resources?kind=cycles')">前往周期与日志</button><button class="secondary" @click="platform.navigate('/pages/workspace/sync')">前往同步任务</button>
  </view></scroll-view>
</template>
<script setup lang="ts">
import { useTheme } from '../../services/theme'
import { ref } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import { api, auth, requireAuth, platform } from '../../services/runtime'
import { PageScope } from '../../services/page-scope'
import StatePanel from '../../components/common/StatePanel.uvue'
interface Task { task_key: string; title: string; description: string | null; count: number }
const items = ref<Task[]>([]), selected = ref(''), loading = ref(false), busy = ref(false), error = ref(''); const scope = new PageScope(() => auth.epoch())
async function load(): Promise<void> { const version = scope.begin(); loading.value = true; busy.value = false; items.value = []; error.value = ''
  try { if (!await requireAuth() || !scope.current(version)) return; const result = await scope.wait(api.get<{ items: Task[] }>('/todos?limit=50')); if (scope.current(version)) items.value = result.items }
  catch (e) { if (scope.current(version)) error.value = e instanceof Error ? e.message : '读取失败' } finally { if (scope.current(version)) loading.value = false }
}
async function complete(): Promise<void> { if (busy.value || !items.value.some(item => item.task_key === selected.value)) return; const key = selected.value, version = scope.begin(); busy.value = true
  try { if (!await requireAuth() || !scope.current(version)) return; await scope.wait(api.patch('/todos/' + encodeURIComponent(key), { status: 'done' })); if (scope.current(version)) { selected.value = ''; await load() } }
  catch (e) { if (scope.current(version)) error.value = e instanceof Error ? e.message : '保存失败' } finally { if (scope.current(version)) busy.value = false }
}
function hide(): void { scope.stop(); items.value = []; selected.value = ''; busy.value = false }
onShow(() => { void load() }); onHide(hide); onUnload(hide)
const themeClass = useTheme()
</script>
<style>
@import '../../styles/tokens.css';
</style>
